# ==============================================
# PINKPATH ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==============================================

# ----------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------
# Get these from your PostgreSQL installation or cloud provider (Supabase, Railway, etc.)
DATABASE_URL=postgresql://username:password@localhost:5432/pinkpath
# Alternative individual connection params:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pinkpath
# DB_USER=your_username
# DB_PASSWORD=your_password

# ----------------------------------------------
# AUTHENTICATION
# ----------------------------------------------
# Generate a secure random string (32+ chars) for JWT signing
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session secret for secure cookies
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-change-this-in-production

# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Set authorized redirect URI to: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----------------------------------------------
# GOOGLE MAPS & ROUTES API
# ----------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
# Enable these APIs:
#   - Maps JavaScript API (frontend)
#   - Routes API (backend - for 8 alternative routes)
#   - Places API (backend - for Popular Times foot traffic)
#   - Geocoding API (backend - address to coordinates)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ----------------------------------------------
# SAN FRANCISCO OPEN DATA (DataSF)
# ----------------------------------------------
# Crime Data API - Get token from: https://data.sfgov.org/profile/edit/developer_settings
# Current dataset: wg3w-h783 (Police Department Incident Reports)
# The existing token in config.js has been migrated here
DATASF_APP_TOKEN=HAsCpzT6ovtq42o9dY9OHqtmD

# SFPD CAD Real-Time Data - Same token works
# Dataset: gnap-fj3t (Law Enforcement Dispatched Calls for Service: Real-Time)
# No additional token needed, uses same DATASF_APP_TOKEN

# Streetlight 311 Complaints - Same token works
# Dataset: 6tt8-ugnj (Streetlights - 311 service requests)
# No additional token needed, uses same DATASF_APP_TOKEN

# ----------------------------------------------
# SFMTA TRANSIT DATA
# ----------------------------------------------
# For foot traffic proxy using transit stop proximity
# GTFS data available at: https://www.sfmta.com/getting-around/muni/developer-resources
# No API key required for static GTFS data
SFMTA_GTFS_URL=https://gtfs.sfmta.com/transitdata/google_transit.zip

# ----------------------------------------------
# SUNRISE/SUNSET API
# ----------------------------------------------
# Free API, no key required
# API: https://api.sunrise-sunset.org/json
SUNRISE_SUNSET_API_URL=https://api.sunrise-sunset.org/json

# ----------------------------------------------
# SMS NOTIFICATIONS (Twilio - Trip Sharing)
# ----------------------------------------------
# Twilio credentials for sending trip sharing notifications
# 1. Create account: https://www.twilio.com/try-twilio
# 2. Get phone number: Console > Phone Numbers > Buy a Number (~$1/month)
# 3. Find credentials: Console > Account Info
# Cost: ~$0.008 per SMS segment (~$0.024 per trip for 3 notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ----------------------------------------------
# RATE LIMITING
# ----------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
