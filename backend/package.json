    "@fastify/secure-session": "^7.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.1",
    "node-fetch": "^3.3.2",
    "pino-pretty": "^10.3.1"
