{
  "name": "@pinkpath/backend",
  "version": "1.0.0",
  "description": "PinkPath backend API server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
