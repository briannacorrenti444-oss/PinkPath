# ==============================================
# PinkPath Backend Dockerfile - Development
# Includes dev dependencies and hot-reload
# ==============================================
# Context: ./backend (set in docker-compose.dev.yml)
# ==============================================

FROM node:20-alpine

# Install build dependencies for bcrypt
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files (context is ./backend)
COPY package*.json ./

# Install ALL dependencies (including devDependencies)
# Note: Using npm install since package-lock.json is at repo root (monorepo)
RUN npm install

# Copy application code (will be overridden by volume mount in dev)
COPY src ./src

# Set environment
ENV NODE_ENV=development
ENV PORT=3001

# Expose port
EXPOSE 3001

# Start with hot-reload
CMD ["npm", "run", "dev"]
